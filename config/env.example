# Secrets only. This file is read automatically and never committed.
# Internal LLM gateway used by the agent CLI
LLM_BASE_URL=https://llm-gateway.your-company.example
LLM_API_KEY=

# Internal MCP servers (streamable HTTP). Jira/Confluence/Bitbucket API tokens live inside those servers.
MCP_ATLASSIAN_URL=https://mcp-atlassian.your-company.example/mcp
MCP_ATLASSIAN_TOKEN=
MCP_SCM_URL=https://mcp-scm.your-company.example/mcp
MCP_SCM_TOKEN=

# Bitbucket HTTP access token for clone, fetch and push
GIT_TOKEN=

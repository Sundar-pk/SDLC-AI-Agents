PORT=8080
HOST=127.0.0.1
DATA_DIR=./data
# claude | opencode | custom
RUNNER=claude
# RUNNER_MODEL=qwen3-coder
RUNNER_TIMEOUT_MS=1200000
STAGE_TOKEN_BUDGET=150000
RUN_TOKEN_BUDGET=1500000
# Internal MCP server (streamable HTTP). Jira and Bitbucket API tokens live in that server, not here.
MCP_URL=https://mcp.internal.example/mcp
# MCP_TOKEN=service-to-service bearer, optional
MCP_TOOL_MAP_FILE=../config/mcp-tool-map.sample.json
MUTATION_THRESHOLD=70
# QUALITY_COMMANDS_FILE=../config/quality-commands.sample.json
# REQUIRE_USER=true   # reject gate and run calls that have no x-user header
